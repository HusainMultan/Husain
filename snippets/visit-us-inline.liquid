{%- comment -%} Params: eyebrow, heading {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="section-header" data-animate>
      <span class="eyebrow">{{ eyebrow | default: 'Our Showrooms' }}</span>
      <h2>{{ heading | default: 'Visit Karun Jewellers' }}</h2>
    </div>
    <div class="visit-grid">
      <div class="visit-card" data-animate>
        <h3>{{ settings.london_label }}</h3>
        <div>{{ settings.london_info }}</div>
      </div>
      <div class="visit-card" data-animate>
        <h3>{{ settings.birmingham_label }}</h3>
        <div>{{ settings.birmingham_info }}</div>
      </div>
    </div>
  </div>
</section>
