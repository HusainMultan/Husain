{%- comment -%}
  Renders a mega-menu panel for a top-level linklist item that has nested links.
  Params: link (a link object from a linklist)
{%- endcomment -%}
{%- liquid
  assign link_handle = link.title | handleize
  assign feature_collection = collections[link_handle]
  assign placeholder_type = 'gem'
  if link.title contains 'Ring'
    assign placeholder_type = 'ring'
  elsif link.title contains 'Earring'
    assign placeholder_type = 'earrings'
  elsif link.title contains 'Necklace'
    assign placeholder_type = 'necklace'
  elsif link.title contains 'Bracelet'
    assign placeholder_type = 'bracelet'
  elsif link.title contains 'Gift'
    assign placeholder_type = 'gift'
  endif
-%}
{%- if link.links.size > 0 -%}
  <div class="mega-menu">
    <div class="page-width mega-menu__grid">
      {%- if link.links.size > 0 -%}
        <div class="mega-menu__col">
          <h4>{{ link.title }}</h4>
          <ul>
            {%- for child_link in link.links -%}
              <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <div class="mega-menu__col mega-menu__feature">
        <a href="{{ link.url }}">
          {%- if feature_collection.featured_image -%}
            <img src="{{ feature_collection.featured_image | image_url: width: 400 }}" alt="" loading="lazy" width="{{ feature_collection.featured_image.width }}" height="{{ feature_collection.featured_image.height }}">
          {%- else -%}
            {% render 'jewellery-placeholder', type: placeholder_type %}
          {%- endif -%}
          <span class="link-underline">Shop {{ link.title }}</span>
        </a>
      </div>
    </div>
  </div>
{%- endif -%}
