{%- comment -%}
  Renders a premium line-art jewellery placeholder illustration, filling its
  container the same way a real photo would (100% width/height, covers the
  box). Used wherever no real product/collection image has been uploaded yet.
  Shopify's built-in placeholder_svg_tag only offers generic apparel icons
  (bags, trainers, sunglasses) which don't suit a jewellery store, so this
  draws jewellery-appropriate shapes instead.

  Params:
    type  - one of: ring, necklace, earrings, bracelet, gem, gift (default: gem)
{%- endcomment -%}
{%- liquid
  assign shape = type | default: 'gem'
-%}
<svg class="jewellery-placeholder" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Jewellery placeholder" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="500" fill="var(--color-ivory)"/>
  <g fill="none" stroke="var(--color-primary)" stroke-width="2.5" opacity="0.55" stroke-linecap="round" stroke-linejoin="round">
    {%- case shape -%}
      {%- when 'ring' -%}
        <circle cx="200" cy="270" r="70"/>
        <circle cx="200" cy="270" r="56"/>
        <path d="M170 200 L200 150 L230 200 Z"/>
        <path d="M182 205 L200 165 L218 205 Z" opacity="0.6"/>
      {%- when 'necklace' -%}
        <path d="M120 160 C120 260 280 260 280 160"/>
        <path d="M150 165 C150 235 250 235 250 165" opacity="0.6"/>
        <path d="M178 258 L200 300 L222 258 Z"/>
        <circle cx="200" cy="252" r="8"/>
      {%- when 'earrings' -%}
        <circle cx="140" cy="180" r="14"/>
        <path d="M140 194 L140 240 C140 270 165 285 165 310 C165 330 115 330 115 310 C115 285 140 270 140 240"/>
        <circle cx="260" cy="180" r="14"/>
        <path d="M260 194 L260 240 C260 270 285 285 285 310 C285 330 235 330 235 310 C235 285 260 270 260 240" opacity="0.6"/>
      {%- when 'bracelet' -%}
        <ellipse cx="200" cy="260" rx="120" ry="46"/>
        <ellipse cx="200" cy="260" rx="98" ry="34" opacity="0.6"/>
        <circle cx="200" cy="214" r="10"/>
        <circle cx="98" cy="260" r="7"/>
        <circle cx="302" cy="260" r="7"/>
      {%- when 'gift' -%}
        <rect x="120" y="220" width="160" height="130" rx="4"/>
        <rect x="120" y="220" width="160" height="34" rx="4" opacity="0.6"/>
        <path d="M200 220 L200 350"/>
        <path d="M160 220 C150 190 180 170 200 190 C220 170 250 190 240 220"/>
      {%- else -%}
        <path d="M140 200 L260 200 L300 250 L200 340 L100 250 Z"/>
        <path d="M140 200 L200 250 L260 200" opacity="0.6"/>
        <path d="M200 250 L200 340" opacity="0.6"/>
        <path d="M170 200 L200 250 L230 200" opacity="0.6"/>
    {%- endcase -%}
  </g>
</svg>
