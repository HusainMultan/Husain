{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'search' %}
{%- endcomment -%}
{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20" aria-hidden="true"><path d="M12 20s-7.2-4.6-9.6-9.1C.8 7.5 2.6 4 6 4c2 0 3.6 1.2 4.5 2.6.9-1.4 2.5-2.6 4.5-2.6 3.4 0 5.2 3.5 3.6 6.9C19.2 15.4 12 20 12 20z"/></svg>
  {%- when 'heart-filled' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M12 20s-7.2-4.6-9.6-9.1C.8 7.5 2.6 4 6 4c2 0 3.6 1.2 4.5 2.6.9-1.4 2.5-2.6 4.5-2.6 3.4 0 5.2 3.5 3.6 6.9C19.2 15.4 12 20 12 20z"/></svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20" aria-hidden="true"><path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  {%- when 'chevron-down' -%}
