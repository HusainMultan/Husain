  {%- when 'headset' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 13v-1a8 8 0 0116 0v1"/><rect x="2" y="13" width="5" height="7" rx="1.5"/><rect x="17" y="13" width="5" height="7" rx="1.5"/><path d="M20 20v.5A2.5 2.5 0 0117.5 23H13"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.7-5.3 4.8 1.6 7-6.3-3.8-6.3 3.8 1.6-7L2 9.3l7.1-.7L12 2z"/></svg>
