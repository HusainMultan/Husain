    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14" aria-hidden="true"><path d="M5 12h14"/></svg>
  {%- when 'diamond' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 9l4-6h8l4 6-10 12L4 9z"/><path d="M4 9h16M9.5 3L8 9l4 12 4-12-1.5-6"/></svg>
{%- endcase -%}
