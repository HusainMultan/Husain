<div class="announcement-bar">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <p {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
        {{ block.settings.text }}
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </p>
    {%- endfor -%}
  {%- else -%}
    <p>{{ 'header.announcement_default' | t }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "default": "Complimentary UK Delivery on Orders Over £75" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Complimentary UK Delivery on Orders Over £75" } },
        { "type": "announcement", "settings": { "text": "Discover Timeless Jewellery, Crafted to Celebrate Every Moment" } }
      ]
    }
  ]
}
{% endschema %}
