<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header" data-animate>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_title = block.settings.title | default: block.settings.collection.title
          assign placeholder_type = 'gem'
          if card_title contains 'Ring'
            assign placeholder_type = 'ring'
          elsif card_title contains 'Earring'
            assign placeholder_type = 'earrings'
          elsif card_title contains 'Necklace'
            assign placeholder_type = 'necklace'
          elsif card_title contains 'Bracelet'
            assign placeholder_type = 'bracelet'
          elsif card_title contains 'Gift'
            assign placeholder_type = 'gift'
          endif
        -%}
        <a href="{{ block.settings.collection.url | default: '#' }}" class="collection-card" data-animate {{ block.shopify_attributes }}>
          <div class="collection-card__media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 800 }} 800w" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="1000">
            {%- elsif block.settings.collection.featured_image -%}
              <img src="{{ block.settings.collection.featured_image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ block.settings.collection.featured_image.width }}" height="{{ block.settings.collection.featured_image.height }}">
            {%- else -%}
              {% render 'jewellery-placeholder', type: placeholder_type %}
            {%- endif -%}
          </div>
          <div class="collection-card__body">
            <h3>{{ block.settings.title | default: block.settings.collection.title }}</h3>
            <span>View Collection</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by Category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collections" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Explore our most-loved jewellery, from everyday essentials to statement pieces." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        { "type": "collection", "settings": { "title": "Rings" } },
        { "type": "collection", "settings": { "title": "Earrings" } },
        { "type": "collection", "settings": { "title": "Necklaces" } },
        { "type": "collection", "settings": { "title": "Bracelets" } },
        { "type": "collection", "settings": { "title": "Wedding Jewellery" } },
        { "type": "collection", "settings": { "title": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}
