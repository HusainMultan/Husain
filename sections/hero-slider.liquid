<section class="hero-slider" data-hero-slider data-autoplay="{{ section.settings.autoplay_seconds | times: 1000 }}">
  <div class="hero-slider__track">
    {%- for block in section.blocks -%}
      <div class="hero-slider__slide" data-hero-slide {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            srcset="{{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1400 }} 1400w, {{ block.settings.image | image_url: width: 2000 }} 2000w"
            sizes="100vw"
            alt="{{ block.settings.heading | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {%- else -%}
          {% render 'jewellery-placeholder', type: block.settings.placeholder_type %}
        {%- endif -%}
        <div class="hero__content">
          {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
          <h1>{{ block.settings.heading }}</h1>
          {%- if block.settings.subtext != blank -%}<p>{{ block.settings.subtext }}</p>{%- endif -%}
          <div class="hero__actions">
            {%- if block.settings.primary_label != blank -%}
              <a href="{{ block.settings.primary_link | default: '#' }}" class="btn">{{ block.settings.primary_label }}</a>
            {%- endif -%}
            {%- if block.settings.secondary_label != blank -%}
              <a href="{{ block.settings.secondary_link | default: '#' }}" class="btn btn--on-dark">{{ block.settings.secondary_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="hero-slider__arrow hero-slider__arrow--prev" data-hero-prev aria-label="Previous slide">{% render 'icon', name: 'chevron-left' %}</button>
      <button type="button" class="hero-slider__arrow hero-slider__arrow--next" data-hero-next aria-label="Next slide">{% render 'icon', name: 'chevron-right' %}</button>
      <div class="hero-slider__dots">
        {%- for block in section.blocks -%}
          <button type="button" class="hero-slider__dot" data-hero-dot aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    { "type": "range", "id": "autoplay_seconds", "min": 0, "max": 10, "step": 1, "label": "Autoplay delay (seconds, 0 to disable)", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "placeholder_type", "label": "Placeholder style (used until an image is uploaded)", "default": "necklace", "options": [
          { "value": "necklace", "label": "Necklace" },
          { "value": "ring", "label": "Ring" },
          { "value": "earrings", "label": "Earrings" },
          { "value": "bracelet", "label": "Bracelet" },
          { "value": "gem", "label": "Gem" }
        ]},
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Karun Jewellers" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless Elegance, Beautifully Crafted" },
        { "type": "textarea", "id": "subtext", "label": "Supporting text" },
        { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop Jewellery" },
        { "type": "url", "id": "primary_link", "label": "Primary button link" },
        { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
        { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
