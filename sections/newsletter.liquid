<section class="section bg-primary">
  <div class="page-width newsletter-section" data-animate>
    <h2>{{ section.settings.heading }}</h2>
    <p style="max-width: 46ch; margin: 0 auto; color: rgba(255,255,255,0.85);">{{ section.settings.subtext }}</p>

    {% form 'customer', id: 'NewsletterFormMain' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required aria-label="Email address" style="background:#fff;">
        <button type="submit" class="btn btn--on-dark">{{ 'general.newsletter.button' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p style="margin-top: 14px;">{{ 'general.newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p style="margin-top: 14px;">{{ 'general.newsletter.error' | t }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay Close to What Inspires You" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Sign up for new arrivals, jewellery inspiration and exclusive updates from Karun Jewellers." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
