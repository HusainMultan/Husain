{% render 'breadcrumbs' %}

<div class="page-width">
  <div class="collection-banner">
    {%- if collection.image -%}
      <img src="{{ collection.image | image_url: width: 1800 }}" alt="{{ collection.title | escape }}" loading="eager">
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag }}
    {%- endif -%}
    <div class="collection-banner__content">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<p style="max-width: 60ch;">{{ collection.description | strip_html }}</p>{%- endif -%}
    </div>
  </div>

  {% paginate collection.products by 24 %}
    <div class="collection-toolbar">
      <div>
        {{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}
      </div>
      <div class="flex items-center gap-8">
        <button type="button" class="btn btn--outline btn--small mobile-filter-toggle" data-drawer-target="FilterDrawer">
          {{ 'collections.general.filter' | t }}
        </button>
        <form method="get" class="select-wrap">
          <select name="sort_by" onchange="this.form.submit()" aria-label="{{ 'collections.general.sort' | t }}">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
          {%- endfor -%}
        </form>
      </div>
    </div>

    <div class="collection-layout">
      <aside class="filters-sidebar">
        {% render 'collection-filters', collection: collection, paginate: paginate %}
      </aside>

      <div>
        {%- if collection.products.size == 0 -%}
          <p>{{ 'collections.general.no_products' | t }}</p>
        {%- else -%}
          <div class="grid grid--4">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">{% render 'icon', name: 'chevron-left' %}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">{% render 'icon', name: 'chevron-right' %}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  {% endpaginate %}
</div>

<div class="drawer" id="FilterDrawer" data-open="false" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'collections.general.filter' | t }}">
    <div class="drawer__header">
      <h2 class="mt-0">{{ 'collections.general.filter' | t }}</h2>
      <button type="button" class="btn btn--icon" data-drawer-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body">
      {% render 'collection-filters', collection: collection, paginate: paginate %}
    </div>
    <div class="drawer__footer">
      <button type="button" class="btn btn--full" data-drawer-close>Show Results</button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main collection",
  "settings": []
}
{% endschema %}
