<section class="hero">
  <div class="hero__media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      {{ 'hero-apparel-2' | placeholder_svg_tag }}
    {%- endif -%}
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link | default: '#' }}" class="btn">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#' }}" class="btn btn--on-dark">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Karun Jewellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless Elegance, Beautifully Crafted" },
    { "type": "textarea", "id": "subtext", "label": "Supporting text", "default": "Discover jewellery designed to celebrate life's most memorable moments." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop Jewellery" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore Collections" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
