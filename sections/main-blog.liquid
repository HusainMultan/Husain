<div class="page-width section">
  <div class="section-header align-left"><h1>{{ blog.title }}</h1></div>
  <div class="grid grid--3">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}">
        <div style="aspect-ratio: 4/3; overflow: hidden; border-radius: var(--radius);">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}" style="width:100%; height:100%; object-fit:cover;">
          {%- else -%}
            {% render 'jewellery-placeholder', type: 'gem' %}
          {%- endif -%}
        </div>
        <div style="padding-top: 14px;">
          <h3>{{ article.title }}</h3>
          <p style="color: var(--color-text-light); font-size: 0.85rem;">{{ article.published_at | date: "%d %B %Y" }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Main blog", "settings": [] }
{% endschema %}
