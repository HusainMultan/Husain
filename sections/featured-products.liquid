<section class="section">
  <div class="page-width">
    <div class="section-header" data-animate>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>

    <div class="grid grid--4">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.product_count) -%}
          <div class="product-card">
            <div class="product-card__media">
              {%- case i -%}
                {%- when 1 -%}{{ 'product-1' | placeholder_svg_tag }}
                {%- when 2 -%}{{ 'product-2' | placeholder_svg_tag }}
                {%- when 3 -%}{{ 'product-3' | placeholder_svg_tag }}
                {%- when 4 -%}{{ 'product-4' | placeholder_svg_tag }}
                {%- when 5 -%}{{ 'product-5' | placeholder_svg_tag }}
                {%- else -%}{{ 'product-6' | placeholder_svg_tag }}
              {%- endcase -%}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">Select a collection in Theme Editor</h3>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="text-center" style="margin-top: 40px;">
        <a href="{{ section.settings.collection.url }}" class="btn btn--outline">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New In" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "min": 4, "max": 8, "step": 4, "label": "Products to show", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Button label", "default": "View All New Arrivals" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
