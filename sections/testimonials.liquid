<section class="section">
  <div class="page-width">
    <div class="section-header" data-animate>
      <span class="demo-label">Demo content — replace with genuine customer reviews</span>
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" data-animate {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars" aria-hidden="true">
            {%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
          </div>
          <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="testimonial-card__name">{{ block.settings.name }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Demo review text — a lovely piece, beautifully presented. This placeholder can be replaced with a genuine customer review.", "name": "Demo Customer" } },
        { "type": "testimonial", "settings": { "quote": "Demo review text — excellent service and a beautiful finish. This placeholder can be replaced with a genuine customer review.", "name": "Demo Customer" } },
        { "type": "testimonial", "settings": { "quote": "Demo review text — exactly what I was looking for. This placeholder can be replaced with a genuine customer review.", "name": "Demo Customer" } }
      ]
    }
  ]
}
{% endschema %}
