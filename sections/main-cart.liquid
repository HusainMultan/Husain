{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
-%}
<div class="page-width section">
  <h1>{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <p>{{ 'cart.general.empty' | t }}</p>
    <a href="/collections/all" class="btn">{{ 'cart.general.continue_shopping' | t }}</a>
  {%- else -%}
    {%- if settings.free_shipping_threshold != blank -%}
      <div class="cart-shipping-msg" style="max-width: 480px;">
        {%- if remaining <= 0 -%}
          {{ 'cart.general.free_shipping_met' | t }}
        {%- else -%}
          {%- assign remaining_money = remaining | money -%}
          {{ 'cart.general.free_shipping_remaining' | t: amount: remaining_money }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <form action="/cart" method="post" novalidate>
      <div class="collection-layout">
        <div style="grid-column: 1 / -1;">
          {%- for item in cart.items -%}
            <div class="cart-line">
              <a href="{{ item.url }}">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="84" height="84">{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
              </a>
              <div>
                <p class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
                {%- if item.variant.title != 'Default Title' -%}<p class="cart-line__variant">{{ item.variant.title }}</p>{%- endif -%}
                <div class="cart-line__qty">
                  <input type="number" name="updates[{{ forloop.index }}]" value="{{ item.quantity }}" min="0" style="width:60px;" aria-label="{{ 'cart.general.quantity' | t }}">
                </div>
              </div>
              <div>{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div style="max-width: 360px; margin-left: auto; margin-top: 24px; text-align: right;">
        <div class="flex items-center" style="justify-content: space-between; margin-bottom: 16px;">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <button type="submit" name="update" class="btn btn--outline btn--full" style="margin-bottom: 10px;">{{ 'cart.general.update' | t }}</button>
        <button type="submit" name="checkout" formaction="/cart" class="btn btn--full">{{ 'cart.general.checkout' | t }}</button>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Main cart", "settings": [] }
{% endschema %}
