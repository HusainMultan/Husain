<div class="page-width section">
  <div class="section-header" data-animate>
    <span class="eyebrow">Shop</span>
    <h1>All Jewellery</h1>
    <p>Browse the full Karun Jewellers collection.</p>
  </div>
  <div class="grid grid--3">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        {%- liquid
          assign placeholder_type = 'gem'
          if collection.title contains 'Ring'
            assign placeholder_type = 'ring'
          elsif collection.title contains 'Earring'
            assign placeholder_type = 'earrings'
          elsif collection.title contains 'Necklace'
            assign placeholder_type = 'necklace'
          elsif collection.title contains 'Bracelet'
            assign placeholder_type = 'bracelet'
          elsif collection.title contains 'Gift'
            assign placeholder_type = 'gift'
          endif
        -%}
        <a href="{{ collection.url }}" class="collection-card" data-animate>
          <div class="collection-card__media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">
            {%- else -%}
              {% render 'jewellery-placeholder', type: placeholder_type %}
            {%- endif -%}
          </div>
          <div class="collection-card__body">
            <h3>{{ collection.title }}</h3>
            <span>View Collection</span>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "All collections", "settings": [] }
{% endschema %}
