<div class="page-width section">
  <div class="section-header align-left" data-animate>
    <span class="eyebrow">Saved for Later</span>
    <h1>{{ section.settings.heading }}</h1>
  </div>
  <div id="WishlistEmpty" hidden>
    <p>You haven't added anything to your wishlist yet.</p>
    <a href="/collections/all" class="btn btn--outline">Explore Jewellery</a>
  </div>
  <div class="grid grid--4" id="WishlistGrid"></div>
</div>

<script>
  (function () {
    var WISHLIST_KEY = "karim-jewellers-wishlist";
    var grid = document.getElementById("WishlistGrid");
    var emptyState = document.getElementById("WishlistEmpty");
    var handles = [];
    try { handles = JSON.parse(localStorage.getItem(WISHLIST_KEY) || "[]"); } catch (e) {}
    if (!handles.length) { emptyState.hidden = false; return; }
    var currencyCode = "{{ cart.currency.iso_code | default: shop.currency }}";
    handles.forEach(function (handle) {
      fetch("/products/" + handle + ".js")
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (product) {
          if (!product) return;
          var img = product.featured_image || (product.images && product.images[0]);
          var productUrl = "/products/" + product.handle;

          var card = document.createElement("div");
          card.className = "product-card";

          var media = document.createElement("div");
          media.className = "product-card__media";
          var mediaLink = document.createElement("a");
          mediaLink.href = productUrl;
          if (img) {
            var imgEl = document.createElement("img");
            imgEl.src = img + "&width=700";
            imgEl.alt = product.title;
            imgEl.loading = "lazy";
            mediaLink.appendChild(imgEl);
          }
          media.appendChild(mediaLink);

          var info = document.createElement("div");
          info.className = "product-card__info";
          var titleEl = document.createElement("h3");
          titleEl.className = "product-card__title";
          var titleLink = document.createElement("a");
          titleLink.href = productUrl;
          titleLink.textContent = product.title;
          titleEl.appendChild(titleLink);
          var priceEl = document.createElement("span");
          priceEl.className = "product-card__price";
          priceEl.textContent = (product.price / 100).toLocaleString("en-GB", { style: "currency", currency: currencyCode });
          info.appendChild(titleEl);
          info.appendChild(priceEl);

          card.appendChild(media);
          card.appendChild(info);
          grid.appendChild(card);
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Wishlist page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Wishlist" }
  ]
}
{% endschema %}
