<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header" data-animate>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- assign has_feature = false -%}
    {%- if section.settings.show_feature -%}{%- assign has_feature = true -%}{%- endif -%}

    <div class="showcase" data-has-feature="{{ has_feature }}" data-feature-position="{{ section.settings.feature_position }}">
      <div class="showcase__carousel-wrap" data-carousel-wrap>
        <div class="showcase__carousel" data-carousel-track>
          {%- if section.settings.collection != blank -%}
            {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.product_count) -%}
              {%- assign remainder = i | modulo: 4 -%}
              <div class="product-card">
                <div class="product-card__media">
                  {%- case remainder -%}
                    {%- when 1 -%}{% render 'jewellery-placeholder', type: 'ring' %}
                    {%- when 2 -%}{% render 'jewellery-placeholder', type: 'earrings' %}
                    {%- when 3 -%}{% render 'jewellery-placeholder', type: 'necklace' %}
                    {%- else -%}{% render 'jewellery-placeholder', type: 'bracelet' %}
                  {%- endcase -%}
                </div>
                <div class="product-card__info">
                  <h3 class="product-card__title">Select a collection in Theme Editor</h3>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <button type="button" class="showcase__arrow showcase__arrow--prev" data-carousel-prev aria-label="Previous">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="showcase__arrow showcase__arrow--next" data-carousel-next aria-label="Next">{% render 'icon', name: 'chevron-right' %}</button>
      </div>

      {%- if has_feature -%}
        <a href="{{ section.settings.feature_link | default: '#' }}" class="showcase__feature" data-animate>
          {%- if section.settings.feature_image -%}
            <img src="{{ section.settings.feature_image | image_url: width: 900 }}" alt="{{ section.settings.feature_heading | escape }}" loading="lazy" width="{{ section.settings.feature_image.width }}" height="{{ section.settings.feature_image.height }}">
          {%- else -%}
            {% render 'jewellery-placeholder', type: 'gem' %}
          {%- endif -%}
          <div class="showcase__feature-content">
            {%- if section.settings.feature_eyebrow != blank -%}<span class="eyebrow">{{ section.settings.feature_eyebrow }}</span>{%- endif -%}
            <h3>{{ section.settings.feature_heading }}</h3>
            {%- if section.settings.feature_button_label != blank -%}<span class="btn btn--small btn--on-dark">{{ section.settings.feature_button_label }}</span>{%- endif -%}
          </div>
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="text-center" style="margin-top: 40px;">
        <a href="{{ section.settings.collection.url }}" class="btn btn--outline">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New In" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "min": 4, "max": 16, "step": 4, "label": "Products to show", "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Button label", "default": "View All" },
    { "type": "header", "content": "Feature panel" },
    { "type": "checkbox", "id": "show_feature", "label": "Show feature panel alongside carousel", "default": false },
    { "type": "select", "id": "feature_position", "label": "Feature panel position", "default": "right", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ]},
    { "type": "image_picker", "id": "feature_image", "label": "Feature image" },
    { "type": "text", "id": "feature_eyebrow", "label": "Feature eyebrow" },
    { "type": "text", "id": "feature_heading", "label": "Feature heading", "default": "Let Promise Solitaire Ring Mount" },
    { "type": "text", "id": "feature_button_label", "label": "Feature button label", "default": "Shop Now" },
    { "type": "url", "id": "feature_link", "label": "Feature link" }
  ],
  "presets": [{ "name": "Product showcase" }]
}
{% endschema %}
